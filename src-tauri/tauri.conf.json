{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Agent History Viewer",
  "version": "0.13.0",
  "identifier": "com.xzl.cchistoryviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Coding Agent History Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local Claude Code and OpenAI Codex history viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFM0QzNEY3MjhEOUY0QUIKUldTcjlOa285elE5cmxoTUk1RXl0TUNvalcvR1JZc0JtdWhaUVdqbW0zTUJlbDAxMGdYVEZhUTIK",
      "endpoints": [
        "https://github.com/XZL-CODE/cc-codex-history-viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
